# Geoapify browser API key for journey location autocomplete.
# Copy to .env.local, supply your key, and restart Vite.
# VITE_* values are PUBLIC in the browser bundle. Use a dedicated key restricted
# in Geoapify MyProjects to your production origin/referrer and local dev origin.
# Never put a private/server credential here. Do not commit .env.local.
# On Vercel: Project Settings > Environment Variables, select Production/Preview,
# set this exact variable name, save, then redeploy. It is embedded at build time.
VITE_GEOAPIFY_API_KEY=

# Open-Meteo's public non-commercial weather endpoint needs no API key.
# Optional existing endpoint overrides:
# VITE_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# VITE_OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Routing reuses VITE_GEOAPIFY_API_KEY on the server. No Google key is needed.
# Optional: use a separate Geoapify server key instead (never prefix it with VITE_).
# GEOAPIFY_API_KEY=
